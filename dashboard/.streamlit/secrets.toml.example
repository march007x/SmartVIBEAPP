# ============================================================
#  secrets.toml.example
#  คัดลอกเป็น .streamlit/secrets.toml แล้วกรอกค่าจริง
#  secrets.toml อยู่ใน .gitignore แล้ว จะไม่ถูก push
#
#  ถ้า deploy บน Streamlit Cloud: ไม่ต้องอัปโหลดไฟล์นี้
#  ให้ไปวางเนื้อหาใน Settings -> Secrets ของแอปแทน
# ============================================================

# ---------- บังคับต้องมี ----------
# ต้องตรงกับ FIREBASE_HOST ในเฟิร์มแวร์เป๊ะ ๆ
# ห้ามมี https:// ข้างหน้า และห้ามมี / ปิดท้าย
FIREBASE_DOMAIN = "xxxxx-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_TOKEN  = "database secret ตัวเดียวกับในเฟิร์มแวร์"

# ---------- ทางเลือก: แจ้งเตือน Telegram ----------
# BotFather -> /newbot -> ได้ TOKEN
# ทักบอทตัวเอง 1 ครั้ง แล้วคุยกับ @userinfobot -> ได้ CHAT_ID
# TELEGRAM_TOKEN   = "123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TELEGRAM_CHAT_ID = "987654321"

# ---------- ทางเลือก: ผู้ช่วย AI ----------
# Groq คือตัวหลักที่แนะนำ - ฟรี เร็ว และใช้บน Streamlit Cloud ได้
# ขอคีย์ที่ https://console.groq.com -> API Keys -> Create API Key
GROQ_API_KEY = "gsk_xxxxxxxx"

# ตัวสำรอง เผื่อ Groq โควตาหมด (ไม่ใส่ก็ได้)
# OPENROUTER_API_KEY = "sk-or-v1-xxxxxxxx"

# หมายเหตุ: Ollama ไม่ต้องใช้คีย์ แต่ใช้ได้เฉพาะตอนรันบนเครื่องตัวเอง
#           บน Streamlit Cloud ตัวเลือกนี้จะถูกซ่อนอัตโนมัติ
